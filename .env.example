# Optional: local Ollama model already installed on your machine
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# Optional: enables recorded-audio transcription with speaker labels
OPENROUTER_API_KEY=
PORT=3000

OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_STT_RESPONSE_FORMAT=verbose_json
OPENROUTER_STT_PROVIDER_OPTIONS=
